{
  "manifest_version": 3,
  "name": "LinkedGuard",
  "version": "1.0.0",
  "description": "Automatically flags unsolicited LinkedIn messages — recruiter spam, crypto scams, cold pitches, MLM, phishing — directly in your conversation list. 100% local, no tracking.",

  "browser_specific_settings": {
    "gecko": {
      "id": "linkedguard@extension",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*"
  ],

  "background": {
    "scripts": ["src/background/service-worker.js"]
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/keyword-lists.js",
        "src/shared/storage.js",
        "src/content/cache.js",
        "src/content/archiver.js",
        "src/content/flagger.js",
        "src/content/dispatcher.js",
        "src/content/detector.js",
        "src/content/observer.js",
        "src/content/thread-scanner.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
